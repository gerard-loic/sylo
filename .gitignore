.venv/
__pycache__/
*.pyc
.env
entities/*
!entities/.gitkeep
!entities/__init__.py
logs/*
!logs/.gitkeep
# Gabarits par défaut versionnés (embarqués dans l'image) ; les dossiers de
# gabarits ajoutés par un projet restent hors du dépôt de base.
mails/*
!mails/gabarit.j2
!mails/assets/
!mails/set_password/
!mails/welcome/
.env
.env.prod
# Fichiers de config des scripts fournis au runtime (montés sur /app/config).
config/*
!config/.gitkeep
