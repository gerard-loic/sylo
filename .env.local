WAKARU_DATABASE_URL=postgresql+psycopg2://postgres:devadmin@172.31.6.61:5432/wakaru
WAKARU_DEFAULT_PAGE_SIZE=50
WAKARU_MAX_PAGE_SIZE=200

WAKARU_SMTP_HOST=smtp.ionos.fr
WAKARU_SMTP_PORT=587
WAKARU_SMTP_USER=demo@e-kodo.fr
WAKARU_SMTP_PASSWORD="demo@e-kodo.fr/2025"
WAKARU_SMTP_USE_TLS=true
WAKARU_SMTP_USE_SSL=false
WAKARU_MAIL_FROM_ADDRESS=demo@e-kodo.fr
WAKARU_MAIL_FROM_NAME=Wakaru

WAKARU_PASSWORD_HASH_ROUNDS=12
WAKARU_AUTH_TOKEN_TTL_MINUTES=1440
WAKARU_PASSWORD_SETUP_URL_PREFIX=http://monsite.fr/choixmotdepasse?token=

# Monte un serveur MCP (Streamable HTTP) sur /mcp, en plus de l'API REST (voir
# "Serveur MCP (optionnel)" dans le README). Désactivé par défaut.
WAKARU_MCP_ENABLED=true
# Fichier optionnel listant les routes à ne pas exposer comme outils MCP (même
# syntaxe que --exclude-file dans scripts/sync_permissions.py).
WAKARU_MCP_EXCLUDE_FILE=