SYLO_DEFAULT_PAGE_SIZE=50
SYLO_MAX_PAGE_SIZE=200

SYLO_SMTP_HOST=smtp.ionos.fr
SYLO_SMTP_PORT=587
SYLO_SMTP_USER=demo@e-kodo.fr
SYLO_SMTP_PASSWORD="demo@e-kodo.fr/2025"
SYLO_SMTP_USE_TLS=true
SYLO_SMTP_USE_SSL=false
