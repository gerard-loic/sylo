WAKARU_DATABASE_URL=postgresql+psycopg2://wakaru:wakaru@localhost:5432/wakaru
WAKARU_DEFAULT_PAGE_SIZE=50
WAKARU_MAX_PAGE_SIZE=200

WAKARU_SMTP_HOST=localhost
WAKARU_SMTP_PORT=587
WAKARU_SMTP_USER=
WAKARU_SMTP_PASSWORD=
WAKARU_SMTP_USE_TLS=true
WAKARU_SMTP_USE_SSL=false
WAKARU_MAIL_FROM_ADDRESS=no-reply@wakaru.local
WAKARU_MAIL_FROM_NAME=Wakaru

# Coût du hashage bcrypt des mots de passe (facteur de travail, plus haut = plus lent/sûr)
WAKARU_PASSWORD_HASH_ROUNDS=12
# Durée de validité d'un token d'authentification (POST /users/login), en minutes
WAKARU_AUTH_TOKEN_TTL_MINUTES=1440
# Préfixe de l'URL envoyée par mail pour choisir son mot de passe (POST /users sans
# `password` : un token est généré et ajouté à la suite de ce préfixe, ex. token=abc)
WAKARU_PASSWORD_SETUP_URL_PREFIX=http://monsite.fr/choixmotdepasse?token=
