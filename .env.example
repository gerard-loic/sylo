SYLO_DATABASE_URL=postgresql+psycopg2://sylo:sylo@localhost:5432/sylo
SYLO_DEFAULT_PAGE_SIZE=50
SYLO_MAX_PAGE_SIZE=200

SYLO_SMTP_HOST=localhost
SYLO_SMTP_PORT=587
SYLO_SMTP_USER=
SYLO_SMTP_PASSWORD=
SYLO_SMTP_USE_TLS=true
SYLO_SMTP_USE_SSL=false
SYLO_MAIL_FROM_ADDRESS=no-reply@sylo.local
SYLO_MAIL_FROM_NAME=Sylo

# Coût du hashage bcrypt des mots de passe (facteur de travail, plus haut = plus lent/sûr)
SYLO_PASSWORD_HASH_ROUNDS=12
# Durée de validité d'un token d'authentification (POST /users/login), en minutes
SYLO_AUTH_TOKEN_TTL_MINUTES=1440
# Préfixe de l'URL envoyée par mail pour choisir son mot de passe (POST /users sans
# `password` : un token est généré et ajouté à la suite de ce préfixe, ex. token=abc)
SYLO_PASSWORD_SETUP_URL_PREFIX=http://monsite.fr/choixmotdepasse?token=

# Monte un serveur MCP (Streamable HTTP) sur /mcp, en plus de l'API REST (voir
# "Serveur MCP (optionnel)" dans le README). Désactivé par défaut.
SYLO_MCP_ENABLED=false
# Fichier optionnel listant les routes à ne pas exposer comme outils MCP (même
# syntaxe que --exclude-file dans scripts/sync_permissions.py).
SYLO_MCP_EXCLUDE_FILE=
